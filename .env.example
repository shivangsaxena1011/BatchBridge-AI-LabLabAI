# Application
APP_ENV=development
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters-long
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
MAX_UPLOAD_MB=15

# Database: SQLite for local exploration; PostgreSQL is recommended for deployment.
# For Docker Compose, set DATABASE_URL=postgresql+psycopg://batchbridge:CHANGE_ME@db:5432/batchbridge
DATABASE_URL=sqlite:///./data/batchbridge.db
POSTGRES_PASSWORD=replace-with-a-unique-postgres-password
DOMAIN=localhost

# Demo data. Set false for a clean production tenant and create your workspace in the UI.
SEED_DEMO_DATA=true
DEMO_SEED_PASSWORD=replace-with-a-unique-demo-password

# Vultr Serverless Inference — add your key from the Vultr console when ready.
# Never put this key in frontend code or commit the .env file.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=deepseek-v4.1-flash-1017
VULTR_INFERENCE_TIMEOUT_SECONDS=45

# Persistence paths (Docker volumes or local directories)
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
